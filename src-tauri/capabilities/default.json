{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop capability with tightly scoped model-download access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://huggingface.co/**" },
        { "url": "https://cdn-lfs.hf.co/**" },
        { "url": "https://cas-bridge.xethub.hf.co/**" }
      ]
    }
  ]
}
